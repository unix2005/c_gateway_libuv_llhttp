[Unit]
Description=C Gateway High Performance Service
After=network.target

[Service]
Type=simple
User=qiao
Group=qiao
WorkingDirectory=/home/qiao/work/c-restful-api
ExecStart=/home/qiao/work/c-restful-api/bin/c_gateway /home/qiao/work/c-restful-api/gateway_config.json
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
